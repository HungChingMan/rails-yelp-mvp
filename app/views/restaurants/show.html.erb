<div class="container mt-2 mb-5">

  <div class="row justify-content-around">

    <div class="col-12 col-sm-8">
      <p>
        <%= link_to '< Restaurants', restaurants_path, class: 'btn-light opacity-25 text-decoration-none' %>
      </p>

      <div class="d-flex align-items-center">
        <h1 class="m-0"><%= @restaurant.name %></h1>
      </div>

      <p class="fw-lighter opacity-75 mt-2"><%= Faker::Restaurant.description  %></p>

      <%# <h3>
        Reviews
        <%= #link_to "+", new_restaurant_review_path(@restaurant), class: 'text-decoration-none text-dark' %>
      </h3>
      <ul>
        <% @restaurant.reviews.each do |review| %>
          <li>
            <%= "⭐️" * review.rating %>
            <%= review.content %>
          </li>
        <% end %>
      </ul>

    </div>

    <div class="col-12 col-sm-4 mt-5">
      <%= render 'restaurants/side_info' %>
    </div>

    <div class="container my-5">
      <h1>Add a Review for <%= @restaurant.name %></h1>
      <%= simple_form_for [@restaurant, @review] do |f| %>
        <%= f.input :rating %>
        <%= f.input :content %>
        <%= f.submit 'Add', class: 'btn btn-success mt-2' %>
      <% end %>
    </div>

  </div>

</div>
